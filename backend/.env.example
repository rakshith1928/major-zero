# ZeroBus backend configuration template — copy to .env and fill in.
# NEVER commit the real .env; it holds database and signing secrets.

# --- Database (ADR-015) ---
# Development default (SQLite file):
DATABASE_URL=sqlite:///D:\path\to\backend\zerobus.db

# Supabase migration target: Session Pooler URI from your project's Connect dialog.
# Encode password special characters. Never put this value in command arguments.
# Example: postgresql+psycopg2://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=require&connect_timeout=10
SUPABASE_DATABASE_URL=
SOURCE_SQLITE_PATH=D:/path/to/backend/zerobus.db
# After migration + verification, set DATABASE_URL to the same Supabase URI.

# --- Secrets: generate with e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"` ---
JWT_SECRET=change-me
FERNET_MASTER=change-me
TICKET_SECRET=change-me

# --- Hugging Face (ADR-11: single cached model, offline) ---
HF_HOME=D:\path\to\models\huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- WebAuthn ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Admin allowlist (comma-separated emails; empty = none) ---
ADMIN_EMAILS=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- External services (empty Razorpay keys = in-app demo checkout) ---
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
